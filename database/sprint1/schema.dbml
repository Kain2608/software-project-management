Ref goods_receipts_purchase_order_id_warehouse_id_fkey: sasms.goods_receipts.(purchase_order_id, warehouse_id) > sasms.purchase_orders.(id, warehouse_id)
Ref goods_receipts_received_by_fkey: sasms.goods_receipts.received_by > sasms.users.id
