Ref identifier_rules_brand_id_fkey: sasms.identifier_rules.brand_id > sasms.brands.id
Ref inventory_import_batches_actor_id_fkey: sasms.inventory_import_batches.actor_id > sasms.users.id
Ref inventory_import_batches_receipt_item_id_fkey: sasms.inventory_import_batches.receipt_item_id > sasms.goods_receipt_items.id
Ref inventory_movements_actor_id_fkey: sasms.inventory_movements.actor_id > sasms.users.id
Ref inventory_movements_device_id_fkey: sasms.inventory_movements.device_id > sasms.devices.id
Ref inventory_movements_order_id_fkey: sasms.inventory_movements.order_id > sasms.sales_orders.id
Ref inventory_movements_warehouse_id_fkey: sasms.inventory_movements.warehouse_id > sasms.warehouses.id
Ref invoices_order_id_fkey: sasms.sales_orders.id - sasms.invoices.order_id
Ref order_devices_device_id_product_id_fkey: sasms.order_devices.(device_id, product_id) > sasms.devices.(id, product_id)
Ref order_devices_order_item_id_order_id_product_id_fkey: sasms.order_devices.(order_item_id, order_id, product_id) > sasms.sales_order_items.(id, order_id, product_id)
Ref payments_confirmed_by_fkey: sasms.payments.confirmed_by > sasms.users.id
Ref payments_order_id_fkey: sasms.payments.order_id > sasms.sales_orders.id
Ref product_images_product_id_fkey: sasms.product_images.product_id > sasms.products.id
Ref products_brand_id_fkey: sasms.products.brand_id > sasms.brands.id
Ref products_category_id_fkey: sasms.products.category_id > sasms.categories.id
Ref purchase_order_items_product_id_fkey: sasms.purchase_order_items.product_id > sasms.products.id
Ref purchase_order_items_purchase_order_id_fkey: sasms.purchase_order_items.purchase_order_id > sasms.purchase_orders.id
Ref purchase_orders_created_by_fkey: sasms.purchase_orders.created_by > sasms.users.id
Ref purchase_orders_supplier_id_fkey: sasms.purchase_orders.supplier_id > sasms.suppliers.id
Ref purchase_orders_warehouse_id_fkey: sasms.purchase_orders.warehouse_id > sasms.warehouses.id
Ref return_items_order_id_device_id_fkey: sasms.return_items.(order_id, device_id) > sasms.order_devices.(order_id, device_id)
