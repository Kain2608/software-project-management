 {"schemaname":"sasms_meta","indexname":"schema_migrations_pkey","indexdef":"CREATE UNIQUE INDEX schema_migrations_pkey ON sasms_meta.schema_migrations USING btree (version)"}], "routines" : [{"routine_name":"assert_live_order_lease","arguments":"p_order uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.assert_live_order_lease(p_order uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE ord sasms.sales_orders;\nBEGIN\n SELECT * INTO STRICT ord FROM sasms.sales_orders WHERE id=p_order FOR UPDATE;\n IF ord.status<>'DRAFT' THEN RAISE EXCEPTION 'Order is not DRAFT' USING ERRCODE='23514'; END IF;\n IF ord.hold_expires_at IS NULL THEN\n  UPDATE sasms.sales_orders SET hold_expires_at=clock_timestamp()+sasms.order_hold_duration(channel) WHERE id=p_order;\n ELSIF ord.hold_expires_at<=clock_timestamp() THEN\n  RAISE EXCEPTION 'Order hold has expired; create a new cart' USING ERRCODE='23514';\n END IF;\nEND $function$\n"}, 
 {"routine_name":"assert_permission","arguments":"p_actor uuid, p_permission text, p_store uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.assert_permission(p_actor uuid, p_permission text, p_store uuid DEFAULT NULL::uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nBEGIN\n    IF NOT sasms.has_permission(p_actor, p_permission, p_store) THEN\n        RAISE EXCEPTION 'Permission denied: %', p_permission USING ERRCODE = '42501';\n    END IF;\nEND;\n$function$\n"}, 
 {"routine_name":"cancel_order","arguments":"p_order uuid, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.cancel_order(p_order uuid, p_actor uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE ord sasms.sales_orders; dev sasms.devices;\nBEGIN\n    SELECT * INTO STRICT ord FROM sasms.sales_orders WHERE id = p_order FOR UPDATE;\n    PERFORM sasms.assert_permission(p_actor,'sales.checkout',ord.store_id);\n    IF ord.status = 'CANCELLED' THEN RETURN; END IF;\n    IF ord.status NOT IN ('DRAFT','RESERVED') THEN RAISE EXCEPTION 'Cannot cancel completed order' USING ERRCODE = '23514'; END IF;\n    IF EXISTS (SELECT 1 FROM sasms.payments WHERE order_id = p_order AND status IN ('PENDING','CAPTURED')) THEN\n        RAISE EXCEPTION 'Reconcile pending/captured funds before cancelling' USING ERRCODE = '23514';\n    END IF;\n    FOR dev IN SELECT * FROM sasms.devices WHERE reserved_order_id = p_order ORDER BY id FOR UPDATE\n    LOOP\n        UPDATE sasms.devices SET status = 'IN_STOCK', reserved_order_id = NULL WHERE id = dev.id;\n        INSERT INTO sasms.inventory_movements(device_id, warehouse_id, kind, order_id, actor_id, reason)\n          VALUES (dev.id, dev.warehouse_id, 'RELEASE', p_order, p_actor, ord.code);\n    END LOOP;\n    -- Keep allocation history. Cancelled selections are not counted as stock ownership.\n    UPDATE sasms.sales_orders SET status = 'CANCELLED' WHERE id = p_order;\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id)\n      VALUES (p_actor, 'sales.cancel', 'sales_order', p_order);\n    INSERT INTO sasms.outbox_events(aggregate_type, aggregate_id, event_type, payload)\n      VALUES ('sales_order', p_order, 'OrderCancelled', jsonb_build_object('order_id', p_order));\nEND;\n$function$\n"}, 
 {"routine_name":"complete_sale","arguments":"p_order uuid, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.complete_sale(p_order uuid, p_actor uuid)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE ord sasms.sales_orders; dev sasms.devices; captured numeric;\nBEGIN\n    SELECT * INTO STRICT ord FROM sasms.sales_orders WHERE id = p_order FOR UPDATE;\n    PERFORM sasms.assert_permission(p_actor,'sales.checkout',ord.store_id);\n    IF ord.status = 'PAID' THEN RETURN ord.id; END IF;\n    IF ord.status <> 'RESERVED' THEN RAISE EXCEPTION 'Order must be RESERVED' USING ERRCODE = '23514'; END IF;\n    IF (ord.hold_expires_at IS NULL OR ord.hold_expires_at<=clock_timestamp()) AND NOT EXISTS(\n      SELECT 1 FROM sasms.payments WHERE order_id=p_order AND status IN ('PENDING','CAPTURED')) THEN\n      RAISE EXCEPTION 'Order hold expired before payment' USING ERRCODE='23514';\n     END IF;\n     SELECT coalesce(sum(amount), 0) INTO captured FROM sasms.payments WHERE order_id = p_order AND status = 'CAPTURED';\n    IF captured <> ord.total_amount THEN\n        RAISE EXCEPTION 'Captured payment must equal total: % <> %', captured, ord.total_amount USING ERRCODE = '23514';\n    END IF;\n    FOR dev IN SELECT d.* FROM sasms.devices d JOIN sasms.order_devices od ON od.device_id = d.id\n        WHERE od.order_id = p_order AND od.active ORDER BY d.id FOR UPDATE OF d\n    LOOP\n        IF dev.status <> 'RESERVED' OR dev.reserved_order_id IS DISTINCT FROM p_order THEN\n            RAISE EXCEPTION 'Reservation ownership mismatch' USING ERRCODE = '23514';\n        END IF;\n        UPDATE sasms.devices SET status = 'SOLD', reserved_order_id = NULL, sold_order_id = p_order, sold_at = now() WHERE id = dev.id;\n        INSERT INTO sasms.inventory_movements(device_id, warehouse_id, kind, order_id, actor_id, reason)\n          VALUES (dev.id, dev.warehouse_id, 'SALE', p_order, p_actor, ord.code);\n    END LOOP;\n    UPDATE sasms.sales_orders SET status = 'PAID', paid_at = now() WHERE id = p_order;\n    -- Internal receipt draft only: never pretends an e-invoice provider has issued it.\n    INSERT INTO sasms.invoices(order_id, number, amount) VALUES (p_order, 'RECEIPT-' || ord.code, ord.total_amount);\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id)\n      VALUES (p_actor, 'sales.checkout', 'sales_order', p_order);\n    INSERT INTO sasms.outbox_events(aggregate_type, aggregate_id, event_type, payload)\n      VALUES ('sales_order', p_order, 'OrderPaid', jsonb_build_object('order_id', p_order, 'total', ord.total_amount));\n    RETURN ord.id;\nEND;\n$function$\n"}, 
 {"routine_name":"create_product","arguments":"p_actor uuid, p_sku text, p_brand uuid, p_category uuid, p_name text, p_specifications jsonb, p_price numeric, p_warranty_months integer","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.create_product(p_actor uuid, p_sku text, p_brand uuid, p_category uuid, p_name text, p_specifications jsonb, p_price numeric, p_warranty_months integer)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE product_id uuid;\nBEGIN\n    -- Shared catalog writes require a deliberately global assignment.\n    PERFORM sasms.assert_permission(p_actor, 'catalog.write', NULL);\n    IF p_price IS NULL OR p_price < 0 OR p_price > 999999999999.99 THEN\n        RAISE EXCEPTION 'Product price is out of range' USING ERRCODE = '23514';\n    END IF;\n    INSERT INTO sasms.products(sku, brand_id, category_id, name, specifications, list_price, warranty_months)\n    VALUES (p_sku, p_brand, p_category, p_name, coalesce(p_specifications, '{}'::jsonb), p_price, p_warranty_months)\n    RETURNING id INTO product_id;\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id, metadata)\n    VALUES (p_actor, 'catalog.create', 'product', product_id,\n            jsonb_build_object('revision', 0));\n    RETURN product_id;\nEND;\n$function$\n"}, 
 {"routine_name":"expire_order_reservation","arguments":"p_order uuid, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.expire_order_reservation(p_order uuid, p_actor uuid)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE ord sasms.sales_orders;\nBEGIN\n SELECT * INTO STRICT ord FROM sasms.sales_orders WHERE id=p_order FOR UPDATE;\n PERFORM sasms.assert_permission(p_actor,'sales.checkout',ord.store_id);\n IF ord.status NOT IN ('DRAFT','RESERVED') OR ord.hold_expires_at IS NULL\n   OR ord.hold_expires_at>clock_timestamp() THEN RETURN false; END IF;\n IF EXISTS(SELECT 1 FROM sasms.payments WHERE order_id=p_order AND status IN ('PENDING','CAPTURED')) THEN\n  RETURN false;\n END IF;\n PERFORM sasms.cancel_order(p_order,p_actor);\n RETURN true;\nEND $function$\n"}, 
 {"routine_name":"find_and_lock_device_for_pos","arguments":"p_store_id uuid, p_order_id uuid, p_order_item_id uuid, p_serial text, p_actor_id uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.find_and_lock_device_for_pos(p_store_id uuid, p_order_id uuid, p_order_item_id uuid, p_serial text, p_actor_id uuid)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE\n    v_order sasms.sales_orders;\n    v_device sasms.devices;\n    v_order_item sasms.sales_order_items;\n    v_clean_serial text;\nBEGIN\n    v_clean_serial := btrim(p_serial);\n\n    -- Verify actor authorization\n    PERFORM sasms.assert_permission(p_actor_id, 'sales.checkout', p_store_id);\n\n    -- Verify and lock the order header\n    SELECT * INTO STRICT v_order \n    FROM sasms.sales_orders \n    WHERE id = p_order_id FOR UPDATE;\n\n    IF v_order.status <> 'DRAFT' THEN\n        RAISE EXCEPTION 'Order % is not in DRAFT status (current: %)', p_order_id, v_order.status\n            USING ERRCODE = '23514';\n    END IF;\n\n    IF v_order.store_id IS DISTINCT FROM p_store_id THEN\n        RAISE EXCEPTION 'Order store % does not match POS store %', v_order.store_id, p_store_id\n            USING ERRCODE = '23514';\n    END IF;\n\n    -- A server-side deadline starts at the first hold (POS 10m / ONLINE 30m).\n    -- Repeated scans and reserve never extend an existing deadline.\n    PERFORM sasms.assert_live_order_lease(p_order_id);\n    SELECT * INTO STRICT v_order FROM sasms.sales_orders WHERE id=p_order_id;\n    IF v_order.hold_expires_at <= clock_timestamp() THEN\n        RAISE EXCEPTION 'Draft order % has expired; create a new POS cart', p_order_id\n            USING ERRCODE = '23514';\n    END IF;\n\n    -- Verify order item exists and belongs to the order\n    SELECT * INTO STRICT v_order_item\n    FROM sasms.sales_order_items\n    WHERE id = p_order_item_id AND order_id = p_order_id;\n\n    -- Find and lock the target device by serial in the order warehouse\n    SELECT * INTO v_device\n    FROM sasms.devices\n    WHERE serial = v_clean_serial\n      AND warehouse_id = v_order.warehouse_id\n    FOR UPDATE NOWAIT;\n\n    IF NOT FOUND THEN\n        RAISE EXCEPTION 'Serial % not found in warehouse % of store %', v_clean_serial, v_order.warehouse_id, p_store_id\n            USING ERRCODE = 'P0002';\n    END IF;\n\n    -- Ensure product match\n    IF v_device.product_id <> v_order_item.product_id THEN\n        RAISE EXCEPTION 'Serial % belongs to product %, expected product %',\n            v_clean_serial, v_device.product_id, v_order_item.product_id\n            USING ERRCODE = '23514';\n    END IF;\n\n    -- Concurrency check: device must be IN_STOCK and not currently reserved\n    IF v_device.status <> 'IN_STOCK' OR v_device.reserved_order_id IS NOT NULL THEN\n        RAISE EXCEPTION 'Device with serial % is not available for sale (status: %)',\n            v_clean_serial, v_device.status\n            USING ERRCODE = '23514';\n    END IF;\n\n    -- Check if another active cart has attached this device\n    IF EXISTS (\n        SELECT 1 FROM sasms.order_devices od\n        JOIN sasms.sales_orders so ON so.id = od.order_id\n        WHERE od.device_id = v_device.id \n          AND od.active = true \n          AND od.order_id <> p_order_id\n          AND so.status = 'DRAFT'\n          AND coalesce(so.hold_expires_at,so.created_at+sasms.order_hold_duration(so.channel)) > clock_timestamp()\n    ) THEN\n        RAISE EXCEPTION 'Device with serial % is temporarily locked by another active POS terminal',\n            v_clean_serial\n            USING ERRCODE = '55P03'; -- lock_not_available\n    END IF;\n\n    -- Link device to order line\n    INSERT INTO sasms.order_devices(order_item_id, order_id, product_id, device_id, active)\n    VALUES (v_order_item.id, p_order_id, v_device.product_id, v_device.id, true)\n    ON CONFLICT (order_id, device_id) \n    DO UPDATE SET active = true, order_item_id = v_order_item.id;\n\n    RETURN v_device.id;\nEND;\n$function$\n"}, 
 {"routine_name":"get_cross_sell_fallback_rules","arguments":"p_product_id uuid, p_store_id uuid, p_limit integer","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.get_cross_sell_fallback_rules(p_product_id uuid, p_store_id uuid, p_limit integer DEFAULT 5)\n RETURNS TABLE(recommended_product_id uuid, sku text, product_name text, price numeric, available_stock bigint, recommendation_reason text)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE\n    v_base_product sasms.products;\nBEGIN\n    IF p_limit IS NULL OR p_limit NOT BETWEEN 1 AND 10 THEN\n        RAISE EXCEPTION 'Limit must be between 1 and 10' USING ERRCODE='23514';\n    END IF;\n    SELECT * INTO STRICT v_base_product \n    FROM sasms.products \n    WHERE id = p_product_id;\n\n    RETURN QUERY\n    SELECT \n        v.product_id,\n        v.sku,\n        v.product_name,\n        v.price,\n        sum(v.available_stock)::bigint,\n        CASE \n            WHEN p.category_id = v_base_product.category_id THEN 'Sản phẩm cùng danh mục còn tồn kho'\n            WHEN p.brand_id = v_base_product.brand_id THEN 'Sản phẩm cùng thương hiệu còn tồn kho'\n            ELSE 'Sản phẩm còn tồn kho tại cửa hàng'\n        END AS recommendation_reason\n    FROM sasms.v_realtime_inventory v\n    JOIN sasms.products p ON p.id = v.product_id\n    WHERE v.store_id = p_store_id\n      AND v.product_id <> p_product_id\n      AND v.available_stock > 0\n    GROUP BY v.product_id,v.sku,v.product_name,v.price,p.category_id,p.brand_id\n    ORDER BY \n        (p.brand_id = v_base_product.brand_id) DESC,\n        sum(v.available_stock) DESC,\n        v.price ASC,\n        v.product_id ASC\n    LIMIT p_limit;\nEND;\n$function$\n"}, 
 {"routine_name":"guard_device_identifier_history","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.guard_device_identifier_history()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nBEGIN\n IF TG_OP='INSERT' THEN\n  IF NEW.legacy_unverified OR NEW.raw_value IS NULL THEN\n   RAISE EXCEPTION 'New identifiers require raw input and current validation' USING ERRCODE='23514';\n  END IF;\n  IF NOT EXISTS(SELECT 1 FROM sasms.devices d WHERE d.id=NEW.device_id\n    AND ((NEW.kind='SERIAL' AND NEW.normalized_value=d.serial)\n      OR (NEW.kind='IMEI' AND NEW.slot=1 AND NEW.normalized_value=d.imei)\n      OR (NEW.kind='IMEI' AND NEW.slot=2 AND d.imei IS NOT NULL))) THEN\n   RAISE EXCEPTION 'Identifier must match its device compatibility fields' USING ERRCODE='23514';\n  END IF;\n  RETURN NEW;\n END IF;\n IF TG_OP='UPDATE' OR EXISTS(SELECT 1 FROM sasms.inventory_movements WHERE device_id=OLD.device_id)\n   OR EXISTS(SELECT 1 FROM sasms.order_devices WHERE device_id=OLD.device_id) THEN\n  RAISE EXCEPTION 'Identifier history cannot be overwritten or removed' USING ERRCODE='23514';\n END IF;\n RETURN OLD;\nEND $function$\n"}, 
 {"routine_name":"guard_identifier_rule","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.guard_identifier_rule()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nBEGIN\n -- Serialize rule activation with device validation on the same brand.\n IF TG_OP='DELETE' THEN\n  PERFORM 1 FROM sasms.brands WHERE id=OLD.brand_id FOR UPDATE;\n  IF OLD.approved_at IS NOT NULL THEN\n   RAISE EXCEPTION 'Approved identifier rules are retained; deactivate instead' USING ERRCODE='23514';\n  END IF;\n  RETURN OLD;\n END IF;\n IF TG_OP='UPDATE' AND NEW.brand_id IS DISTINCT FROM OLD.brand_id THEN\n  RAISE EXCEPTION 'Rule brand is immutable; create a new rule version' USING ERRCODE='23514';\n END IF;\n PERFORM 1 FROM sasms.brands WHERE id=NEW.brand_id FOR UPDATE;\n IF TG_OP='UPDATE' AND OLD.approved_at IS NOT NULL\n    AND (to_jsonb(NEW)-'is_active') IS DISTINCT FROM (to_jsonb(OLD)-'is_active') THEN\n  RAISE EXCEPTION 'Approved rule definition is immutable; create a new version' USING ERRCODE='23514';\n END IF;\n -- Parse the regex before it can be approved, even for a draft rule.\n BEGIN\n  PERFORM 'REGEX-PROBE' ~ NEW.serial_pattern;\n EXCEPTION WHEN invalid_regular_expression THEN\n  RAISE EXCEPTION 'Invalid serial regular expression' USING ERRCODE='23514';\n END;\n IF NEW.approved_at IS NOT NULL AND (NEW.source_reference IS NULL OR length(btrim(NEW.source_reference))=0) THEN\n  RAISE EXCEPTION 'Approved rule requires a source reference' USING ERRCODE='23514';\n END IF;\n RETURN NEW;\nEND $function$\n"}, 
 {"routine_name":"guard_order_child","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.guard_order_child()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE old_order uuid; new_order uuid; ord sasms.sales_orders; dev sasms.devices;\nBEGIN\n IF TG_OP<>'INSERT' THEN old_order:=OLD.order_id; END IF;\n IF TG_OP<>'DELETE' THEN new_order:=NEW.order_id; END IF;\n IF TG_OP='UPDATE' AND old_order IS DISTINCT FROM new_order THEN\n  RAISE EXCEPTION 'Moving rows between orders is forbidden' USING ERRCODE='23514';\n END IF;\n SELECT * INTO STRICT ord FROM sasms.sales_orders WHERE id=coalesce(new_order,old_order) FOR UPDATE;\n IF TG_TABLE_NAME='payments' THEN\n  IF TG_OP<>'INSERT' AND OLD.status='CAPTURED' THEN\n   RAISE EXCEPTION 'Captured payments are immutable; use a reviewed refund workflow' USING ERRCODE='23514';\n  END IF;\n  IF ord.status NOT IN ('DRAFT','RESERVED') THEN\n   RAISE EXCEPTION 'Order is frozen: %',ord.status USING ERRCODE='23514';\n  END IF;\n  IF TG_OP='DELETE' THEN\n   IF OLD.status='PENDING' THEN RAISE EXCEPTION 'Reconcile pending payment before removal' USING ERRCODE='23514'; END IF;\n   RETURN OLD;\n  END IF;\n  IF NEW.status IN ('PENDING','CAPTURED') THEN\n   IF ord.status<>'RESERVED' THEN RAISE EXCEPTION 'Reserve before initiating payment' USING ERRCODE='23514'; END IF;\n   -- A verified callback for an already in-flight payment must not lose stock\n   -- merely because its response arrives after the original deadline.\n   IF NOT (TG_OP='UPDATE' AND OLD.status='PENDING')\n      AND (ord.hold_expires_at IS NULL OR ord.hold_expires_at<=clock_timestamp()) THEN\n    RAISE EXCEPTION 'Hold expired before payment initiation' USING ERRCODE='23514';\n   END IF;\n  END IF;\n ELSE\n  IF ord.status<>'DRAFT' THEN RAISE EXCEPTION 'Order is frozen: %',ord.status USING ERRCODE='23514'; END IF;\n  IF TG_TABLE_NAME='order_devices' AND TG_OP<>'DELETE' THEN\n   IF NEW.active THEN\n   PERFORM sasms.assert_live_order_lease(ord.id);\n   SELECT * INTO STRICT dev FROM sasms.devices WHERE id=NEW.device_id FOR UPDATE NOWAIT;\n   IF dev.status<>'IN_STOCK' OR dev.warehouse_id<>ord.warehouse_id THEN\n    RAISE EXCEPTION 'Device unavailable in this warehouse' USING ERRCODE='23514';\n   END IF;\n   IF EXISTS(SELECT 1 FROM sasms.order_devices d JOIN sasms.sales_orders o ON o.id=d.order_id\n     WHERE d.device_id=dev.id AND d.active AND d.order_id<>ord.id AND o.status='DRAFT'\n       AND coalesce(o.hold_expires_at,o.created_at+sasms.order_hold_duration(o.channel))>clock_timestamp()) THEN\n    RAISE EXCEPTION 'Device held by another cart' USING ERRCODE='55P03';\n   END IF;\n   END IF;\n  END IF;\n END IF;\n IF TG_OP='DELETE' THEN RETURN OLD; END IF;\n RETURN NEW;\nEND $function$\n"}, 
 {"routine_name":"guard_product_identifier_profile","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.guard_product_identifier_profile()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nBEGIN\n IF TG_OP<>'INSERT' THEN\n  RAISE EXCEPTION 'Approved SKU profile is retained; a reviewed versioned change is required' USING ERRCODE='23514';\n END IF;\n PERFORM 1 FROM sasms.products WHERE id=NEW.product_id FOR UPDATE;\n PERFORM sasms.assert_permission(NEW.approved_by,'catalog.write',NULL);\n RETURN NEW;\nEND $function$\n"}, 
 {"routine_name":"guard_product_revision","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.guard_product_revision()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nBEGIN\n    NEW.sku := upper(btrim(NEW.sku));\n    NEW.name := btrim(NEW.name);\n    IF TG_OP = 'INSERT' THEN\n        NEW.revision := 0;\n    ELSE\n        NEW.revision := OLD.revision + 1;\n    END IF;\n    NEW.updated_at := clock_timestamp();\n    RETURN NEW;\nEND;\n$function$\n"}, 
 {"routine_name":"has_permission","arguments":"p_actor uuid, p_permission text, p_store uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.has_permission(p_actor uuid, p_permission text, p_store uuid DEFAULT NULL::uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\n    SELECT EXISTS (\n        SELECT 1 FROM sasms.users u\n        JOIN sasms.user_roles ur ON ur.user_id = u.id\n        JOIN sasms.role_permissions rp ON rp.role_code = ur.role_code\n        WHERE u.id = p_actor AND u.is_active\n          AND rp.permission_code = p_permission\n          AND (ur.store_id IS NULL OR (p_store IS NOT NULL AND ur.store_id = p_store))\n    ) AND (p_store IS NULL OR EXISTS (\n        SELECT 1 FROM sasms.stores s WHERE s.id = p_store AND s.is_active\n    ));\n$function$\n"}, 
 {"routine_name":"order_hold_duration","arguments":"channel text","security_definer":false,"configuration":["search_path=pg_catalog"],"definition":"CREATE OR REPLACE FUNCTION sasms.order_hold_duration(channel text)\n RETURNS interval\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\n SET search_path TO 'pg_catalog'\nAS $function$\n SELECT CASE channel WHEN 'POS' THEN interval '10 minutes' WHEN 'ONLINE' THEN interval '30 minutes' END;\n$function$\n"}, 
 {"routine_name":"receive_device","arguments":"p_receipt_item uuid, p_serial text, p_imei text, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.receive_device(p_receipt_item uuid, p_serial text, p_imei text, p_actor uuid)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE ids uuid[];\nBEGIN\n ids := sasms.receive_device_batch(p_receipt_item,gen_random_uuid(),\n    jsonb_build_array(jsonb_build_object('serial',p_serial,'imei',p_imei)),p_actor);\n RETURN ids[1];\nEND $function$\n"}, 
 {"routine_name":"receive_device_batch","arguments":"p_receipt_item uuid, p_request_key uuid, p_devices jsonb, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.receive_device_batch(p_receipt_item uuid, p_request_key uuid, p_devices jsonb, p_actor uuid)\n RETURNS uuid[]\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE store uuid; row_data jsonb; normalized jsonb:='[]'; legacy_payload jsonb:='[]';\n serial_value text; imei_value text; imei2_value text; existing sasms.inventory_import_batches;\n ids uuid[]:=ARRAY[]::uuid[]; device uuid;\nBEGIN\n SELECT w.store_id INTO store FROM sasms.goods_receipt_items ri\n JOIN sasms.goods_receipts r ON r.id=ri.receipt_id JOIN sasms.warehouses w ON w.id=r.warehouse_id\n WHERE ri.id=p_receipt_item;\n IF NOT FOUND THEN RAISE EXCEPTION 'Receipt item not found' USING ERRCODE='23503'; END IF;\n PERFORM sasms.assert_permission(p_actor,'inventory.receive',store);\n IF p_request_key IS NULL OR p_devices IS NULL OR jsonb_typeof(p_devices)<>'array' THEN\n  RAISE EXCEPTION 'Request key and device array are required' USING ERRCODE='23514';\n END IF;\n IF jsonb_array_length(p_devices) NOT BETWEEN 1 AND 500 THEN\n  RAISE EXCEPTION 'Batch must contain 1..500 devices' USING ERRCODE='23514';\n END IF;\n FOR row_data IN SELECT value FROM jsonb_array_elements(p_devices) LOOP\n  IF jsonb_typeof(row_data)<>'object' THEN RAISE EXCEPTION 'Device must be an object' USING ERRCODE='23514'; END IF;\n  IF EXISTS(SELECT 1 FROM jsonb_object_keys(row_data) k WHERE k NOT IN ('serial','imei','imei2'))\n    OR jsonb_typeof(row_data->'serial') IS DISTINCT FROM 'string'\n    OR (row_data ? 'imei' AND jsonb_typeof(row_data->'imei') NOT IN ('string','null'))\n    OR (row_data ? 'imei2' AND jsonb_typeof(row_data->'imei2') NOT IN ('string','null')) THEN\n   RAISE EXCEPTION 'Device keys/types are invalid' USING ERRCODE='23514';\n  END IF;\n  serial_value:=btrim(row_data->>'serial'); imei_value:=nullif(btrim(row_data->>'imei'),'');\n  imei2_value:=nullif(btrim(row_data->>'imei2'),'');\n  IF length(serial_value) NOT BETWEEN 1 AND 128 OR serial_value ~ '[[:cntrl:]]' THEN\n   RAISE EXCEPTION 'Invalid Serial format' USING ERRCODE='23514';\n  END IF;\n  normalized:=normalized||jsonb_build_array(jsonb_build_object('serial',serial_value,'imei',imei_value,'imei2',imei2_value));\n  legacy_payload:=legacy_payload||jsonb_build_array(jsonb_build_object('serial',upper(serial_value),'imei',imei_value));\n END LOOP;\n PERFORM pg_advisory_xact_lock(hashtextextended('sasms.inventory-import:'||p_request_key::text,0));\n SELECT * INTO existing FROM sasms.inventory_import_batches WHERE request_key=p_request_key;\n IF FOUND THEN\n  IF existing.receipt_item_id IS DISTINCT FROM p_receipt_item OR existing.actor_id IS DISTINCT FROM p_actor\n    OR (existing.normalized_payload IS DISTINCT FROM normalized AND NOT (\n      NOT EXISTS(SELECT 1 FROM jsonb_array_elements(existing.normalized_payload) x WHERE x ? 'imei2')\n      AND existing.normalized_payload=legacy_payload\n      AND NOT EXISTS(SELECT 1 FROM jsonb_array_elements(normalized) x WHERE x->>'imei2' IS NOT NULL))) THEN\n   RAISE EXCEPTION 'Request key reused with a different receipt, actor or payload' USING ERRCODE='23514';\n  END IF;\n  RETURN existing.device_ids;\n END IF;\n FOR row_data IN SELECT value FROM jsonb_array_elements(p_devices) LOOP\n  device:=sasms.receive_device_unchecked_s0(p_receipt_item,row_data->>'serial',row_data->>'imei',p_actor);\n  -- Secondary IMEI shares the same global registry and receipt transaction.\n  IF nullif(btrim(row_data->>'imei2'),'') IS NOT NULL THEN\n   IF NOT coalesce(sasms.valid_imei(btrim(row_data->>'imei2')),false)\n      OR nullif(btrim(row_data->>'imei'),'') IS NULL THEN\n    RAISE EXCEPTION 'Invalid secondary IMEI' USING ERRCODE='23514';\n   END IF;\n   INSERT INTO sasms.device_identifiers(device_id,kind,slot,raw_value,normalized_value)\n   VALUES(device,'IMEI',2,row_data->>'imei2',btrim(row_data->>'imei2'));\n  END IF;\n  ids:=array_append(ids,device);\n END LOOP;\n INSERT INTO sasms.inventory_import_batches(request_key,receipt_item_id,actor_id,normalized_payload,device_ids)\n VALUES(p_request_key,p_receipt_item,p_actor,normalized,ids);\n RETURN ids;\nEND $function$\n"}, 
 {"routine_name":"receive_device_unchecked_s0","arguments":"p_receipt_item uuid, p_serial text, p_imei text, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.receive_device_unchecked_s0(p_receipt_item uuid, p_serial text, p_imei text, p_actor uuid)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE line sasms.goods_receipt_items; receipt sasms.goods_receipts; po_line sasms.purchase_order_items;\n        po sasms.purchase_orders;\n        device_id uuid; current_count bigint;\nBEGIN\n    SELECT * INTO STRICT line FROM sasms.goods_receipt_items WHERE id = p_receipt_item;\n    -- Lock the PO header first so approval cannot be revoked mid-receive.\n    SELECT * INTO STRICT po FROM sasms.purchase_orders WHERE id = line.purchase_order_id FOR UPDATE;\n    SELECT * INTO STRICT receipt FROM sasms.goods_receipts WHERE id = line.receipt_id FOR UPDATE;\n    SELECT * INTO STRICT line FROM sasms.goods_receipt_items WHERE id = p_receipt_item FOR UPDATE;\n    SELECT * INTO STRICT po_line FROM sasms.purchase_order_items WHERE id = line.purchase_order_item_id FOR UPDATE;\n    IF receipt.status <> 'OPEN' OR po.status <> 'APPROVED' OR line.purchase_order_id <> po.id THEN\n        RAISE EXCEPTION 'Receipt must be OPEN and purchase order APPROVED' USING ERRCODE = '23514';\n    END IF;\n    SELECT count(*) INTO current_count FROM sasms.devices WHERE receipt_item_id = line.id;\n    IF current_count >= line.quantity THEN\n        RAISE EXCEPTION 'Receipt quantity exceeded' USING ERRCODE = '23514';\n    END IF;\n    SELECT count(*) INTO current_count FROM sasms.devices d JOIN sasms.goods_receipt_items ri ON ri.id = d.receipt_item_id\n      WHERE ri.purchase_order_item_id = po_line.id;\n    IF current_count >= po_line.quantity THEN\n        RAISE EXCEPTION 'Purchase order quantity exceeded' USING ERRCODE = '23514';\n    END IF;\n    INSERT INTO sasms.devices(product_id, receipt_item_id, warehouse_id, serial, imei)\n      VALUES (line.product_id, line.id, receipt.warehouse_id, p_serial, p_imei)\n      RETURNING id INTO device_id;\n    INSERT INTO sasms.inventory_movements(device_id, warehouse_id, kind, actor_id, reason)\n      VALUES (device_id, receipt.warehouse_id, 'RECEIVE', p_actor, receipt.code);\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id)\n      VALUES (p_actor, 'inventory.receive', 'device', device_id);\n    INSERT INTO sasms.outbox_events(aggregate_type, aggregate_id, event_type, payload)\n      VALUES ('device', device_id, 'DeviceReceived', jsonb_build_object('device_id', device_id));\n    RETURN device_id;\nEND;\n$function$\n"}, 
 {"routine_name":"release_device_lock","arguments":"p_order_id uuid, p_device_id uuid, p_actor_id uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.release_device_lock(p_order_id uuid, p_device_id uuid, p_actor_id uuid)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE\n    v_order sasms.sales_orders;\n    v_released boolean;\nBEGIN\n    SELECT * INTO STRICT v_order \n    FROM sasms.sales_orders \n    WHERE id = p_order_id FOR UPDATE;\n\n    -- Derive the scope from the persisted order; never trust a caller-supplied\n    -- store. This also rejects NULL, inactive and unauthorized actor IDs.\n    PERFORM sasms.assert_permission(p_actor_id, 'sales.checkout', v_order.store_id);\n\n    IF v_order.status <> 'DRAFT' THEN\n        RAISE EXCEPTION 'Cannot release device from non-draft order %', p_order_id\n            USING ERRCODE = '23514';\n    END IF;\n\n    -- Use the same header -> device lock order as selection/reservation. The\n    -- device row serializes release against another terminal selecting it.\n    PERFORM d.id\n    FROM sasms.devices d\n    JOIN sasms.order_devices od ON od.device_id = d.id\n    WHERE od.order_id = p_order_id AND od.device_id = p_device_id AND od.active\n    FOR UPDATE OF d NOWAIT;\n\n    UPDATE sasms.order_devices\n    SET active = false \n    WHERE order_id = p_order_id AND device_id = p_device_id AND active;\n    v_released := FOUND;\n\n    RETURN v_released;\nEND;\n$function$\n"}, 
 {"routine_name":"reserve_order","arguments":"p_order uuid, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.reserve_order(p_order uuid, p_actor uuid)\n RETURNS numeric\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE ord sasms.sales_orders; dev sasms.devices; amount numeric;\nBEGIN\n    SELECT * INTO STRICT ord FROM sasms.sales_orders WHERE id = p_order FOR UPDATE;\n    PERFORM sasms.assert_permission(p_actor,'sales.checkout',ord.store_id);\n    IF ord.status IN ('RESERVED','PAID') THEN RETURN ord.total_amount; END IF;\n    IF ord.status <> 'DRAFT' THEN RAISE EXCEPTION 'Order is not DRAFT' USING ERRCODE = '23514'; END IF;\n    PERFORM sasms.assert_live_order_lease(p_order);\n     IF NOT EXISTS (SELECT 1 FROM sasms.sales_order_items WHERE order_id = p_order) THEN\n        RAISE EXCEPTION 'Empty order' USING ERRCODE = '23514';\n    END IF;\n    IF EXISTS (\n        SELECT 1 FROM sasms.sales_order_items i\n        WHERE i.order_id = p_order AND i.quantity <> (\n            SELECT count(*) FROM sasms.order_devices od WHERE od.order_item_id = i.id AND od.active\n        )\n    ) THEN RAISE EXCEPTION 'Device count must equal line quantity' USING ERRCODE = '23514'; END IF;\n    -- Global order avoids deadlocks when carts select multiple common devices.\n    FOR dev IN SELECT d.* FROM sasms.devices d JOIN sasms.order_devices od ON od.device_id = d.id\n        WHERE od.order_id = p_order AND od.active ORDER BY d.id FOR UPDATE OF d\n    LOOP\n        IF dev.status <> 'IN_STOCK' OR dev.warehouse_id <> ord.warehouse_id THEN\n            RAISE EXCEPTION 'Device unavailable or in another warehouse: %', dev.id USING ERRCODE = '23514';\n        END IF;\n        IF EXISTS(SELECT 1 FROM sasms.order_devices od JOIN sasms.sales_orders so ON so.id=od.order_id\n       WHERE od.device_id=dev.id AND od.active AND od.order_id<>p_order AND so.status='DRAFT'\n       AND coalesce(so.hold_expires_at,so.created_at+sasms.order_hold_duration(so.channel))>clock_timestamp()) THEN\n      RAISE EXCEPTION 'Device held by another cart' USING ERRCODE='55P03';\n     END IF;\n     UPDATE sasms.devices SET status = 'RESERVED', reserved_order_id = p_order WHERE id = dev.id;\n        INSERT INTO sasms.inventory_movements(device_id, warehouse_id, kind, order_id, actor_id, reason)\n          VALUES (dev.id, dev.warehouse_id, 'RESERVE', p_order, p_actor, ord.code);\n    END LOOP;\n    SELECT sum(line_total) INTO amount FROM sasms.sales_order_items WHERE order_id = p_order;\n    UPDATE sasms.sales_orders SET status = 'RESERVED', total_amount = amount WHERE id = p_order;\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id)\n      VALUES (p_actor, 'sales.reserve', 'sales_order', p_order);\n    INSERT INTO sasms.outbox_events(aggregate_type, aggregate_id, event_type, payload)\n      VALUES ('sales_order', p_order, 'OrderReserved', jsonb_build_object('order_id', p_order, 'total', amount));\n    RETURN amount;\nEND;\n$function$\n"}, 
 {"routine_name":"sync_device_identifiers","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.sync_device_identifiers()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nBEGIN\n IF TG_OP='DELETE' THEN\n  DELETE FROM sasms.device_identifiers WHERE device_id=OLD.id;\n  RETURN OLD;\n END IF;\n INSERT INTO sasms.device_identifiers(device_id,kind,slot,raw_value,normalized_value)\n VALUES(NEW.id,'SERIAL',1,NEW.serial_raw,NEW.serial);\n IF NEW.imei IS NOT NULL THEN\n  INSERT INTO sasms.device_identifiers(device_id,kind,slot,raw_value,normalized_value)\n  VALUES(NEW.id,'IMEI',1,NEW.imei_raw,NEW.imei);\n END IF;\n RETURN NEW;\nEND $function$\n"}, 
 {"routine_name":"update_product","arguments":"p_actor uuid, p_product uuid, p_expected_revision integer, p_name text, p_specifications jsonb, p_price numeric, p_warranty_months integer, p_active boolean","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.update_product(p_actor uuid, p_product uuid, p_expected_revision integer, p_name text, p_specifications jsonb, p_price numeric, p_warranty_months integer, p_active boolean)\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE current_revision integer; next_revision integer;\nBEGIN\n    PERFORM sasms.assert_permission(p_actor, 'catalog.write', NULL);\n    SELECT revision INTO current_revision FROM sasms.products WHERE id = p_product FOR UPDATE;\n    IF NOT FOUND THEN\n        RAISE EXCEPTION 'Product not found' USING ERRCODE = 'P0002';\n    END IF;\n    IF p_expected_revision IS DISTINCT FROM current_revision THEN\n        RAISE EXCEPTION 'Product revision changed; reload before updating' USING ERRCODE = '40001';\n    END IF;\n    IF p_price IS NULL OR p_price < 0 OR p_price > 999999999999.99 THEN\n        RAISE EXCEPTION 'Product price is out of range' USING ERRCODE = '23514';\n    END IF;\n    UPDATE sasms.products\n       SET name = p_name, specifications = p_specifications, list_price = p_price,\n           warranty_months = p_warranty_months, is_active = p_active\n     WHERE id = p_product RETURNING revision INTO next_revision;\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id, metadata)\n    VALUES (p_actor, 'catalog.update', 'product', p_product,\n            jsonb_build_object('from_revision', current_revision, 'revision', next_revision, 'active', p_active));\n    RETURN next_revision;\nEND;\n$function$\n"}, 
 {"routine_name":"valid_imei","arguments":"value text","security_definer":false,"configuration":["search_path=pg_catalog"],"definition":"CREATE OR REPLACE FUNCTION sasms.valid_imei(value text)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE\n SET search_path TO 'pg_catalog'\nAS $function$\n SELECT value ~ '^[0-9]{15}$' AND (\n  SELECT sum(CASE WHEN n>9 THEN n-9 ELSE n END)%10=0\n  FROM (SELECT substring(value FROM i FOR 1)::integer *\n    CASE WHEN i%2=0 THEN 2 ELSE 1 END n FROM generate_series(1,15) i\n    WHERE value ~ '^[0-9]{15}$') digits\n );\n$function$\n"}, 
 {"routine_name":"validate_device_identifiers","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.validate_device_identifiers()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE profile sasms.product_identifier_profiles;\nBEGIN\n IF TG_OP='UPDATE' AND (NEW.serial,NEW.imei,NEW.product_id,\n     NEW.serial_raw,NEW.imei_raw) IS DISTINCT FROM\n    (OLD.serial,OLD.imei,OLD.product_id,OLD.serial_raw,OLD.imei_raw) THEN\n  RAISE EXCEPTION 'Identifiers are immutable; a reviewed manager correction with reason and audit is required' USING ERRCODE='23514';\n END IF;\n NEW.serial_raw:=coalesce(NEW.serial_raw,NEW.serial);\n NEW.imei_raw:=coalesce(NEW.imei_raw,NEW.imei);\n NEW.serial:=btrim(NEW.serial); NEW.imei:=nullif(btrim(NEW.imei),'');\n IF NEW.serial IS NULL OR length(NEW.serial) NOT BETWEEN 1 AND 128 OR NEW.serial ~ '[[:cntrl:]]'\n    OR btrim(NEW.serial_raw) IS DISTINCT FROM NEW.serial THEN\n  RAISE EXCEPTION 'Invalid Serial: required, trimmed, 1..128 characters, no control characters' USING ERRCODE='23514';\n END IF;\n IF NEW.imei IS NOT NULL AND NOT coalesce(sasms.valid_imei(NEW.imei),false) THEN\n  RAISE EXCEPTION 'IMEI must pass fifteen-digit Luhn' USING ERRCODE='23514';\n END IF;\n PERFORM 1 FROM sasms.products WHERE id=NEW.product_id FOR SHARE;\n SELECT * INTO profile FROM sasms.product_identifier_profiles WHERE product_id=NEW.product_id;\n IF FOUND AND ((profile.profile_code='SONY_TV_7' AND NEW.serial !~ '^[0-9]{7}$')\n   OR (profile.requires_imei AND NEW.imei IS NULL)) THEN\n  RAISE EXCEPTION 'Device does not satisfy its approved SKU identifier profile' USING ERRCODE='23514';\n END IF;\n RETURN NEW;\nEND $function$\n"}], "triggers" : [{"table_name":"device_identifiers","trigger_name":"guard_device_identifier_history","definition":"CREATE TRIGGER guard_device_identifier_history BEFORE INSERT OR DELETE OR UPDATE ON sasms.device_identifiers FOR EACH ROW EXECUTE FUNCTION sasms.guard_device_identifier_history()"}, 
 {"table_name":"devices","trigger_name":"cleanup_device_identifiers","definition":"CREATE TRIGGER cleanup_device_identifiers BEFORE DELETE ON sasms.devices FOR EACH ROW EXECUTE FUNCTION sasms.sync_device_identifiers()"}, 
 {"table_name":"devices","trigger_name":"sync_device_identifiers","definition":"CREATE TRIGGER sync_device_identifiers AFTER INSERT ON sasms.devices FOR EACH ROW EXECUTE FUNCTION sasms.sync_device_identifiers()"}, 
 {"table_name":"devices","trigger_name":"validate_identifiers","definition":"CREATE TRIGGER validate_identifiers BEFORE INSERT OR UPDATE OF serial, imei, product_id, serial_raw, imei_raw ON sasms.devices FOR EACH ROW EXECUTE FUNCTION sasms.validate_device_identifiers()"}, 
 {"table_name":"identifier_rules","trigger_name":"guard_identifier_rules","definition":"CREATE TRIGGER guard_identifier_rules BEFORE INSERT OR DELETE OR UPDATE ON sasms.identifier_rules FOR EACH ROW EXECUTE FUNCTION sasms.guard_identifier_rule()"}, 
 {"table_name":"order_devices","trigger_name":"guard_order_devices","definition":"CREATE TRIGGER guard_order_devices BEFORE INSERT OR DELETE OR UPDATE ON sasms.order_devices FOR EACH ROW EXECUTE FUNCTION sasms.guard_order_child()"}, 
 {"table_name":"payments","trigger_name":"guard_payments","definition":"CREATE TRIGGER guard_payments BEFORE INSERT OR DELETE OR UPDATE ON sasms.payments FOR EACH ROW EXECUTE FUNCTION sasms.guard_order_child()"}, 
 {"table_name":"product_identifier_profiles","trigger_name":"guard_product_identifier_profile","definition":"CREATE TRIGGER guard_product_identifier_profile BEFORE INSERT OR DELETE OR UPDATE ON sasms.product_identifier_profiles FOR EACH ROW EXECUTE FUNCTION sasms.guard_product_identifier_profile()"}, 
 {"table_name":"products","trigger_name":"guard_product_revision","definition":"CREATE TRIGGER guard_product_revision BEFORE INSERT OR UPDATE ON sasms.products FOR EACH ROW EXECUTE FUNCTION sasms.guard_product_revision()"}, 
 {"table_name":"sales_order_items","trigger_name":"guard_sales_items","definition":"CREATE TRIGGER guard_sales_items BEFORE INSERT OR DELETE OR UPDATE ON sasms.sales_order_items FOR EACH ROW EXECUTE FUNCTION sasms.guard_order_child()"}], "views" : [{"view_name":"stock_availability","definition":" SELECT warehouse_id,\n    product_id,\n    count(*) FILTER (WHERE status = 'IN_STOCK'::text) AS available,\n    count(*) FILTER (WHERE status = 'RESERVED'::text) AS reserved,\n    count(*) FILTER (WHERE status = 'SOLD'::text) AS sold\n   FROM sasms.devices\n  GROUP BY warehouse_id, product_id;"}, 
 {"view_name":"v_realtime_inventory","definition":" SELECT w.store_id,\n    s.code AS store_code,\n    s.name AS store_name,\n    w.id AS warehouse_id,\n    w.code AS warehouse_code,\n    w.name AS warehouse_name,\n    p.id AS product_id,\n    p.sku,\n    p.name AS product_name,\n    p.list_price AS price,\n    count(d.id) AS total_physical_stock,\n    count(d.id) FILTER (WHERE d.status = 'IN_STOCK'::text) AS available_stock,\n    count(d.id) FILTER (WHERE d.status = 'RESERVED'::text) AS reserved_stock,\n    count(d.id) FILTER (WHERE d.status = 'SOLD'::text) AS sold_stock\n   FROM sasms.products p\n     CROSS JOIN sasms.warehouses w\n     JOIN sasms.stores s ON s.id = w.store_id\n     LEFT JOIN sasms.devices d ON d.product_id = p.id AND d.warehouse_id = w.id\n  WHERE p.is_active AND s.is_active\n  GROUP BY w.store_id, s.code, s.name, w.id, w.code, w.name, p.id, p.sku, p.name, p.list_price;"}], "acl" : [{"kind":"relation","object_name":"sasms.ai_recommendations","grantee":"sasms_app","privilege_type":"SELECT","is_grantable":false}, 
