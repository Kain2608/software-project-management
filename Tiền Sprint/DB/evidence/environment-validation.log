 {"schemaname":"sasms","indexname":"warranties_device_id_policy_id_key","indexdef":"CREATE UNIQUE INDEX warranties_device_id_policy_id_key ON sasms.warranties USING btree (device_id, policy_id)"}, 
 {"schemaname":"sasms","indexname":"warranties_pkey","indexdef":"CREATE UNIQUE INDEX warranties_pkey ON sasms.warranties USING btree (id)"}, 
