 {"schemaname":"sasms_meta","indexname":"schema_migrations_pkey","indexdef":"CREATE UNIQUE INDEX schema_migrations_pkey ON sasms_meta.schema_migrations USING btree (version)"}], "routines" : [{"routine_name":"assert_permission","arguments":"p_actor uuid, p_permission text, p_store uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.assert_permission(p_actor uuid, p_permission text, p_store uuid DEFAULT NULL::uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nBEGIN\n    IF NOT sasms.has_permission(p_actor, p_permission, p_store) THEN\n        RAISE EXCEPTION 'Permission denied: %', p_permission USING ERRCODE = '42501';\n    END IF;\nEND;\n$function$\n"},
 {"routine_name":"cancel_order","arguments":"p_order uuid, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.cancel_order(p_order uuid, p_actor uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE ord sasms.sales_orders; dev sasms.devices;\nBEGIN\n    SELECT * INTO STRICT ord FROM sasms.sales_orders WHERE id = p_order FOR UPDATE;\n    IF ord.status = 'CANCELLED' THEN RETURN; END IF;\n    IF ord.status NOT IN ('DRAFT','RESERVED') THEN RAISE EXCEPTION 'Cannot cancel completed order' USING ERRCODE = '23514'; END IF;\n    IF EXISTS (SELECT 1 FROM sasms.payments WHERE order_id = p_order AND status = 'CAPTURED') THEN\n        RAISE EXCEPTION 'Reconcile captured funds before cancelling' USING ERRCODE = '23514';\n    END IF;\n    FOR dev IN SELECT * FROM sasms.devices WHERE reserved_order_id = p_order ORDER BY id FOR UPDATE\n    LOOP\n        UPDATE sasms.devices SET status = 'IN_STOCK', reserved_order_id = NULL WHERE id = dev.id;\n        INSERT INTO sasms.inventory_movements(device_id, warehouse_id, kind, order_id, actor_id, reason)\n          VALUES (dev.id, dev.warehouse_id, 'RELEASE', p_order, p_actor, ord.code);\n    END LOOP;\n    -- Keep allocation history. Cancelled selections are not counted as stock ownership.\n    UPDATE sasms.sales_orders SET status = 'CANCELLED' WHERE id = p_order;\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id)\n      VALUES (p_actor, 'sales.cancel', 'sales_order', p_order);\n    INSERT INTO sasms.outbox_events(aggregate_type, aggregate_id, event_type, payload)\n      VALUES ('sales_order', p_order, 'OrderCancelled', jsonb_build_object('order_id', p_order));\nEND;\n$function$\n"},
 {"routine_name":"complete_sale","arguments":"p_order uuid, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.complete_sale(p_order uuid, p_actor uuid)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE ord sasms.sales_orders; dev sasms.devices; captured numeric;\nBEGIN\n    SELECT * INTO STRICT ord FROM sasms.sales_orders WHERE id = p_order FOR UPDATE;\n    IF ord.status = 'PAID' THEN RETURN ord.id; END IF;\n    IF ord.status <> 'RESERVED' THEN RAISE EXCEPTION 'Order must be RESERVED' USING ERRCODE = '23514'; END IF;\n    SELECT coalesce(sum(amount), 0) INTO captured FROM sasms.payments WHERE order_id = p_order AND status = 'CAPTURED';\n    IF captured <> ord.total_amount THEN\n        RAISE EXCEPTION 'Captured payment must equal total: % <> %', captured, ord.total_amount USING ERRCODE = '23514';\n    END IF;\n    FOR dev IN SELECT d.* FROM sasms.devices d JOIN sasms.order_devices od ON od.device_id = d.id\n        WHERE od.order_id = p_order AND od.active ORDER BY d.id FOR UPDATE OF d\n    LOOP\n        IF dev.status <> 'RESERVED' OR dev.reserved_order_id IS DISTINCT FROM p_order THEN\n            RAISE EXCEPTION 'Reservation ownership mismatch' USING ERRCODE = '23514';\n        END IF;\n        UPDATE sasms.devices SET status = 'SOLD', reserved_order_id = NULL, sold_order_id = p_order, sold_at = now() WHERE id = dev.id;\n        INSERT INTO sasms.inventory_movements(device_id, warehouse_id, kind, order_id, actor_id, reason)\n          VALUES (dev.id, dev.warehouse_id, 'SALE', p_order, p_actor, ord.code);\n    END LOOP;\n    UPDATE sasms.sales_orders SET status = 'PAID', paid_at = now() WHERE id = p_order;\n    -- Internal receipt draft only: never pretends an e-invoice provider has issued it.\n    INSERT INTO sasms.invoices(order_id, number, amount) VALUES (p_order, 'RECEIPT-' || ord.code, ord.total_amount);\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id)\n      VALUES (p_actor, 'sales.checkout', 'sales_order', p_order);\n    INSERT INTO sasms.outbox_events(aggregate_type, aggregate_id, event_type, payload)\n      VALUES ('sales_order', p_order, 'OrderPaid', jsonb_build_object('order_id', p_order, 'total', ord.total_amount));\n    RETURN ord.id;\nEND;\n$function$\n"},
 {"routine_name":"create_product","arguments":"p_actor uuid, p_sku text, p_brand uuid, p_category uuid, p_name text, p_specifications jsonb, p_price numeric, p_warranty_months integer","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.create_product(p_actor uuid, p_sku text, p_brand uuid, p_category uuid, p_name text, p_specifications jsonb, p_price numeric, p_warranty_months integer)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE product_id uuid;\nBEGIN\n    -- Shared catalog writes require a deliberately global assignment.\n    PERFORM sasms.assert_permission(p_actor, 'catalog.write', NULL);\n    IF p_price IS NULL OR p_price < 0 OR p_price > 999999999999.99 THEN\n        RAISE EXCEPTION 'Product price is out of range' USING ERRCODE = '23514';\n    END IF;\n    INSERT INTO sasms.products(sku, brand_id, category_id, name, specifications, list_price, warranty_months)\n    VALUES (p_sku, p_brand, p_category, p_name, coalesce(p_specifications, '{}'::jsonb), p_price, p_warranty_months)\n    RETURNING id INTO product_id;\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id, metadata)\n    VALUES (p_actor, 'catalog.create', 'product', product_id,\n            jsonb_build_object('revision', 0));\n    RETURN product_id;\nEND;\n$function$\n"},
 {"routine_name":"guard_identifier_rule","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.guard_identifier_rule()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nBEGIN\n -- Serialize rule activation with device validation on the same brand.\n IF TG_OP='DELETE' THEN\n  PERFORM 1 FROM sasms.brands WHERE id=OLD.brand_id FOR UPDATE;\n  IF OLD.approved_at IS NOT NULL THEN\n   RAISE EXCEPTION 'Approved identifier rules are retained; deactivate instead' USING ERRCODE='23514';\n  END IF;\n  RETURN OLD;\n END IF;\n IF TG_OP='UPDATE' AND NEW.brand_id IS DISTINCT FROM OLD.brand_id THEN\n  RAISE EXCEPTION 'Rule brand is immutable; create a new rule version' USING ERRCODE='23514';\n END IF;\n PERFORM 1 FROM sasms.brands WHERE id=NEW.brand_id FOR UPDATE;\n IF TG_OP='UPDATE' AND OLD.approved_at IS NOT NULL\n    AND (to_jsonb(NEW)-'is_active') IS DISTINCT FROM (to_jsonb(OLD)-'is_active') THEN\n  RAISE EXCEPTION 'Approved rule definition is immutable; create a new version' USING ERRCODE='23514';\n END IF;\n -- Parse the regex before it can be approved, even for a draft rule.\n BEGIN\n  PERFORM 'REGEX-PROBE' ~ NEW.serial_pattern;\n EXCEPTION WHEN invalid_regular_expression THEN\n  RAISE EXCEPTION 'Invalid serial regular expression' USING ERRCODE='23514';\n END;\n IF NEW.approved_at IS NOT NULL AND (NEW.source_reference IS NULL OR length(btrim(NEW.source_reference))=0) THEN\n  RAISE EXCEPTION 'Approved rule requires a source reference' USING ERRCODE='23514';\n END IF;\n RETURN NEW;\nEND $function$\n"},
 {"routine_name":"guard_order_child","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.guard_order_child()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE old_order uuid; new_order uuid; order_status text;\nBEGIN\n    IF TG_OP <> 'INSERT' THEN old_order := OLD.order_id; END IF;\n    IF TG_OP <> 'DELETE' THEN new_order := NEW.order_id; END IF;\n    IF TG_OP = 'UPDATE' AND old_order <> new_order THEN\n        RAISE EXCEPTION 'Moving rows between orders is forbidden' USING ERRCODE = '23514';\n    END IF;\n    IF TG_TABLE_NAME = 'payments' AND TG_OP <> 'INSERT' THEN\n        IF OLD.status = 'CAPTURED' THEN\n            RAISE EXCEPTION 'Captured payments are immutable; use a reviewed refund workflow' USING ERRCODE = '23514';\n        END IF;\n    END IF;\n    SELECT status INTO order_status FROM sasms.sales_orders\n      WHERE id = coalesce(new_order, old_order) FOR UPDATE;\n    IF (TG_TABLE_NAME = 'payments' AND order_status NOT IN ('DRAFT','RESERVED'))\n       OR (TG_TABLE_NAME <> 'payments' AND order_status <> 'DRAFT') THEN\n        RAISE EXCEPTION 'Order is frozen: %', order_status USING ERRCODE = '23514';\n    END IF;\n    IF TG_OP = 'DELETE' THEN RETURN OLD; END IF;\n    RETURN NEW;\nEND;\n$function$\n"},
 {"routine_name":"guard_product_revision","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.guard_product_revision()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nBEGIN\n    NEW.sku := upper(btrim(NEW.sku));\n    NEW.name := btrim(NEW.name);\n    IF TG_OP = 'INSERT' THEN\n        NEW.revision := 0;\n    ELSE\n        NEW.revision := OLD.revision + 1;\n    END IF;\n    NEW.updated_at := clock_timestamp();\n    RETURN NEW;\nEND;\n$function$\n"},
 {"routine_name":"has_permission","arguments":"p_actor uuid, p_permission text, p_store uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.has_permission(p_actor uuid, p_permission text, p_store uuid DEFAULT NULL::uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\n    SELECT EXISTS (\n        SELECT 1 FROM sasms.users u\n        JOIN sasms.user_roles ur ON ur.user_id = u.id\n        JOIN sasms.role_permissions rp ON rp.role_code = ur.role_code\n        WHERE u.id = p_actor AND u.is_active\n          AND rp.permission_code = p_permission\n          AND (ur.store_id IS NULL OR (p_store IS NOT NULL AND ur.store_id = p_store))\n    ) AND (p_store IS NULL OR EXISTS (\n        SELECT 1 FROM sasms.stores s WHERE s.id = p_store AND s.is_active\n    ));\n$function$\n"},
 {"routine_name":"receive_device","arguments":"p_receipt_item uuid, p_serial text, p_imei text, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.receive_device(p_receipt_item uuid, p_serial text, p_imei text, p_actor uuid)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE ids uuid[];\nBEGIN\n ids := sasms.receive_device_batch(p_receipt_item,gen_random_uuid(),\n    jsonb_build_array(jsonb_build_object('serial',p_serial,'imei',p_imei)),p_actor);\n RETURN ids[1];\nEND $function$\n"},
 {"routine_name":"receive_device_batch","arguments":"p_receipt_item uuid, p_request_key uuid, p_devices jsonb, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.receive_device_batch(p_receipt_item uuid, p_request_key uuid, p_devices jsonb, p_actor uuid)\n RETURNS uuid[]\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE store uuid; row_data jsonb; normalized jsonb := '[]';\n        serial_value text; imei_value text; existing sasms.inventory_import_batches;\n        ids uuid[] := ARRAY[]::uuid[];\nBEGIN\n SELECT w.store_id INTO store\n  FROM sasms.goods_receipt_items ri JOIN sasms.goods_receipts r ON r.id=ri.receipt_id\n  JOIN sasms.warehouses w ON w.id=r.warehouse_id WHERE ri.id=p_receipt_item;\n IF NOT FOUND THEN RAISE EXCEPTION 'Receipt item not found' USING ERRCODE='23503'; END IF;\n PERFORM sasms.assert_permission(p_actor,'inventory.receive',store);\n IF p_request_key IS NULL THEN RAISE EXCEPTION 'Request key is required' USING ERRCODE='23514'; END IF;\n IF p_devices IS NULL OR jsonb_typeof(p_devices)<>'array' THEN\n  RAISE EXCEPTION 'Devices must be a JSON array' USING ERRCODE='23514';\n END IF;\n IF jsonb_array_length(p_devices) NOT BETWEEN 1 AND 500 THEN\n  RAISE EXCEPTION 'Batch must contain 1..500 devices' USING ERRCODE='23514';\n END IF;\n FOR row_data IN SELECT value FROM jsonb_array_elements(p_devices)\n LOOP\n  IF jsonb_typeof(row_data)<>'object' THEN\n   RAISE EXCEPTION 'Each device must be an object' USING ERRCODE='23514';\n  END IF;\n  IF EXISTS(SELECT 1 FROM jsonb_object_keys(row_data) AS keys(key) WHERE key NOT IN ('serial','imei'))\n     OR jsonb_typeof(row_data->'serial') IS DISTINCT FROM 'string'\n     OR (row_data ? 'imei' AND jsonb_typeof(row_data->'imei') NOT IN ('string','null')) THEN\n   RAISE EXCEPTION 'Device keys/types are invalid; expected serial string and optional imei string/null' USING ERRCODE='23514';\n  END IF;\n  serial_value := upper(btrim(row_data->>'serial'));\n  imei_value := nullif(btrim(row_data->>'imei'),'');\n  IF serial_value IS NULL OR length(serial_value) NOT BETWEEN 1 AND 100 OR serial_value ~ '[[:space:]]'\n     OR (imei_value IS NOT NULL AND imei_value !~ '^[0-9]{15}$') THEN\n   RAISE EXCEPTION 'Invalid generic Serial/IMEI format' USING ERRCODE='23514';\n  END IF;\n  normalized := normalized || jsonb_build_array(jsonb_build_object('serial',serial_value,'imei',imei_value));\n END LOOP;\n IF EXISTS(SELECT 1 FROM jsonb_array_elements(normalized) x GROUP BY x->>'serial' HAVING count(*)>1)\n    OR EXISTS(SELECT 1 FROM jsonb_array_elements(normalized) x WHERE x->>'imei' IS NOT NULL\n              GROUP BY x->>'imei' HAVING count(*)>1) THEN\n  RAISE EXCEPTION 'Duplicate identifier within batch' USING ERRCODE='23505';\n END IF;\n -- Same key is serialized even when requests target different receipt items.\n PERFORM pg_advisory_xact_lock(hashtextextended('sasms.inventory-import:'||p_request_key::text,0));\n SELECT * INTO existing FROM sasms.inventory_import_batches WHERE request_key=p_request_key;\n IF FOUND THEN\n  IF existing.receipt_item_id IS DISTINCT FROM p_receipt_item OR existing.actor_id IS DISTINCT FROM p_actor\n     OR existing.normalized_payload IS DISTINCT FROM normalized THEN\n   RAISE EXCEPTION 'Request key reused with a different receipt, actor or payload' USING ERRCODE='23514';\n  END IF;\n  RETURN existing.device_ids;\n END IF;\n FOR row_data IN SELECT value FROM jsonb_array_elements(normalized)\n LOOP\n  ids := array_append(ids,sasms.receive_device_unchecked_s0(p_receipt_item,row_data->>'serial',row_data->>'imei',p_actor));\n END LOOP;\n INSERT INTO sasms.inventory_import_batches(request_key,receipt_item_id,actor_id,normalized_payload,device_ids)\n  VALUES(p_request_key,p_receipt_item,p_actor,normalized,ids);\n RETURN ids;\nEND $function$\n"},
 {"routine_name":"receive_device_unchecked_s0","arguments":"p_receipt_item uuid, p_serial text, p_imei text, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.receive_device_unchecked_s0(p_receipt_item uuid, p_serial text, p_imei text, p_actor uuid)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE line sasms.goods_receipt_items; receipt sasms.goods_receipts; po_line sasms.purchase_order_items;\n        po sasms.purchase_orders;\n        device_id uuid; current_count bigint;\nBEGIN\n    SELECT * INTO STRICT line FROM sasms.goods_receipt_items WHERE id = p_receipt_item;\n    -- Lock the PO header first so approval cannot be revoked mid-receive.\n    SELECT * INTO STRICT po FROM sasms.purchase_orders WHERE id = line.purchase_order_id FOR UPDATE;\n    SELECT * INTO STRICT receipt FROM sasms.goods_receipts WHERE id = line.receipt_id FOR UPDATE;\n    SELECT * INTO STRICT line FROM sasms.goods_receipt_items WHERE id = p_receipt_item FOR UPDATE;\n    SELECT * INTO STRICT po_line FROM sasms.purchase_order_items WHERE id = line.purchase_order_item_id FOR UPDATE;\n    IF receipt.status <> 'OPEN' OR po.status <> 'APPROVED' OR line.purchase_order_id <> po.id THEN\n        RAISE EXCEPTION 'Receipt must be OPEN and purchase order APPROVED' USING ERRCODE = '23514';\n    END IF;\n    SELECT count(*) INTO current_count FROM sasms.devices WHERE receipt_item_id = line.id;\n    IF current_count >= line.quantity THEN\n        RAISE EXCEPTION 'Receipt quantity exceeded' USING ERRCODE = '23514';\n    END IF;\n    SELECT count(*) INTO current_count FROM sasms.devices d JOIN sasms.goods_receipt_items ri ON ri.id = d.receipt_item_id\n      WHERE ri.purchase_order_item_id = po_line.id;\n    IF current_count >= po_line.quantity THEN\n        RAISE EXCEPTION 'Purchase order quantity exceeded' USING ERRCODE = '23514';\n    END IF;\n    INSERT INTO sasms.devices(product_id, receipt_item_id, warehouse_id, serial, imei)\n      VALUES (line.product_id, line.id, receipt.warehouse_id, upper(btrim(p_serial)), nullif(btrim(p_imei), ''))\n      RETURNING id INTO device_id;\n    INSERT INTO sasms.inventory_movements(device_id, warehouse_id, kind, actor_id, reason)\n      VALUES (device_id, receipt.warehouse_id, 'RECEIVE', p_actor, receipt.code);\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id)\n      VALUES (p_actor, 'inventory.receive', 'device', device_id);\n    INSERT INTO sasms.outbox_events(aggregate_type, aggregate_id, event_type, payload)\n      VALUES ('device', device_id, 'DeviceReceived', jsonb_build_object('device_id', device_id));\n    RETURN device_id;\nEND;\n$function$\n"},
 {"routine_name":"reserve_order","arguments":"p_order uuid, p_actor uuid","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.reserve_order(p_order uuid, p_actor uuid)\n RETURNS numeric\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE ord sasms.sales_orders; dev sasms.devices; amount numeric;\nBEGIN\n    SELECT * INTO STRICT ord FROM sasms.sales_orders WHERE id = p_order FOR UPDATE;\n    IF ord.status IN ('RESERVED','PAID') THEN RETURN ord.total_amount; END IF;\n    IF ord.status <> 'DRAFT' THEN RAISE EXCEPTION 'Order is not DRAFT' USING ERRCODE = '23514'; END IF;\n    IF NOT EXISTS (SELECT 1 FROM sasms.sales_order_items WHERE order_id = p_order) THEN\n        RAISE EXCEPTION 'Empty order' USING ERRCODE = '23514';\n    END IF;\n    IF EXISTS (\n        SELECT 1 FROM sasms.sales_order_items i\n        WHERE i.order_id = p_order AND i.quantity <> (\n            SELECT count(*) FROM sasms.order_devices od WHERE od.order_item_id = i.id AND od.active\n        )\n    ) THEN RAISE EXCEPTION 'Device count must equal line quantity' USING ERRCODE = '23514'; END IF;\n    -- Global order avoids deadlocks when carts select multiple common devices.\n    FOR dev IN SELECT d.* FROM sasms.devices d JOIN sasms.order_devices od ON od.device_id = d.id\n        WHERE od.order_id = p_order AND od.active ORDER BY d.id FOR UPDATE OF d\n    LOOP\n        IF dev.status <> 'IN_STOCK' OR dev.warehouse_id <> ord.warehouse_id THEN\n            RAISE EXCEPTION 'Device unavailable or in another warehouse: %', dev.id USING ERRCODE = '23514';\n        END IF;\n        UPDATE sasms.devices SET status = 'RESERVED', reserved_order_id = p_order WHERE id = dev.id;\n        INSERT INTO sasms.inventory_movements(device_id, warehouse_id, kind, order_id, actor_id, reason)\n          VALUES (dev.id, dev.warehouse_id, 'RESERVE', p_order, p_actor, ord.code);\n    END LOOP;\n    SELECT sum(line_total) INTO amount FROM sasms.sales_order_items WHERE order_id = p_order;\n    UPDATE sasms.sales_orders SET status = 'RESERVED', total_amount = amount WHERE id = p_order;\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id)\n      VALUES (p_actor, 'sales.reserve', 'sales_order', p_order);\n    INSERT INTO sasms.outbox_events(aggregate_type, aggregate_id, event_type, payload)\n      VALUES ('sales_order', p_order, 'OrderReserved', jsonb_build_object('order_id', p_order, 'total', amount));\n    RETURN amount;\nEND;\n$function$\n"},
 {"routine_name":"update_product","arguments":"p_actor uuid, p_product uuid, p_expected_revision integer, p_name text, p_specifications jsonb, p_price numeric, p_warranty_months integer, p_active boolean","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.update_product(p_actor uuid, p_product uuid, p_expected_revision integer, p_name text, p_specifications jsonb, p_price numeric, p_warranty_months integer, p_active boolean)\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE current_revision integer; next_revision integer;\nBEGIN\n    PERFORM sasms.assert_permission(p_actor, 'catalog.write', NULL);\n    SELECT revision INTO current_revision FROM sasms.products WHERE id = p_product FOR UPDATE;\n    IF NOT FOUND THEN\n        RAISE EXCEPTION 'Product not found' USING ERRCODE = 'P0002';\n    END IF;\n    IF p_expected_revision IS DISTINCT FROM current_revision THEN\n        RAISE EXCEPTION 'Product revision changed; reload before updating' USING ERRCODE = '40001';\n    END IF;\n    IF p_price IS NULL OR p_price < 0 OR p_price > 999999999999.99 THEN\n        RAISE EXCEPTION 'Product price is out of range' USING ERRCODE = '23514';\n    END IF;\n    UPDATE sasms.products\n       SET name = p_name, specifications = p_specifications, list_price = p_price,\n           warranty_months = p_warranty_months, is_active = p_active\n     WHERE id = p_product RETURNING revision INTO next_revision;\n    INSERT INTO sasms.audit_logs(actor_id, action, entity_type, entity_id, metadata)\n    VALUES (p_actor, 'catalog.update', 'product', p_product,\n            jsonb_build_object('from_revision', current_revision, 'revision', next_revision, 'active', p_active));\n    RETURN next_revision;\nEND;\n$function$\n"},
 {"routine_name":"validate_device_identifiers","arguments":"","security_definer":true,"configuration":["search_path=pg_catalog, sasms"],"definition":"CREATE OR REPLACE FUNCTION sasms.validate_device_identifiers()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'sasms'\nAS $function$\nDECLARE brand uuid; rule sasms.identifier_rules;\nBEGIN\n NEW.serial := upper(btrim(NEW.serial));\n NEW.imei := nullif(btrim(NEW.imei),'');\n SELECT brand_id INTO brand FROM sasms.products WHERE id=NEW.product_id FOR SHARE;\n IF NOT FOUND THEN RAISE EXCEPTION 'Product not found' USING ERRCODE='23503'; END IF;\n PERFORM 1 FROM sasms.brands WHERE id=brand FOR SHARE;\n SELECT * INTO rule FROM sasms.identifier_rules WHERE brand_id=brand AND is_active;\n IF FOUND THEN\n  IF NEW.serial !~ rule.serial_pattern OR (rule.imei_required AND NEW.imei IS NULL) THEN\n   RAISE EXCEPTION 'Device does not satisfy the active approved identifier rule' USING ERRCODE='23514';\n  END IF;\n END IF;\n RETURN NEW;\nEND $function$\n"}], "triggers" : [{"table_name":"devices","trigger_name":"validate_identifiers","definition":"CREATE TRIGGER validate_identifiers BEFORE INSERT OR UPDATE OF serial, imei, product_id ON sasms.devices FOR EACH ROW EXECUTE FUNCTION sasms.validate_device_identifiers()"},
 {"table_name":"identifier_rules","trigger_name":"guard_identifier_rules","definition":"CREATE TRIGGER guard_identifier_rules BEFORE INSERT OR DELETE OR UPDATE ON sasms.identifier_rules FOR EACH ROW EXECUTE FUNCTION sasms.guard_identifier_rule()"},
 {"table_name":"order_devices","trigger_name":"guard_order_devices","definition":"CREATE TRIGGER guard_order_devices BEFORE INSERT OR DELETE OR UPDATE ON sasms.order_devices FOR EACH ROW EXECUTE FUNCTION sasms.guard_order_child()"},
 {"table_name":"payments","trigger_name":"guard_payments","definition":"CREATE TRIGGER guard_payments BEFORE INSERT OR DELETE OR UPDATE ON sasms.payments FOR EACH ROW EXECUTE FUNCTION sasms.guard_order_child()"},
 {"table_name":"products","trigger_name":"guard_product_revision","definition":"CREATE TRIGGER guard_product_revision BEFORE INSERT OR UPDATE ON sasms.products FOR EACH ROW EXECUTE FUNCTION sasms.guard_product_revision()"},
 {"table_name":"sales_order_items","trigger_name":"guard_sales_items","definition":"CREATE TRIGGER guard_sales_items BEFORE INSERT OR DELETE OR UPDATE ON sasms.sales_order_items FOR EACH ROW EXECUTE FUNCTION sasms.guard_order_child()"}], "views" : [{"view_name":"stock_availability","definition":" SELECT warehouse_id,\n    product_id,\n    count(*) FILTER (WHERE status = 'IN_STOCK'::text) AS available,\n    count(*) FILTER (WHERE status = 'RESERVED'::text) AS reserved,\n    count(*) FILTER (WHERE status = 'SOLD'::text) AS sold\n   FROM sasms.devices\n  GROUP BY warehouse_id, product_id;"}], "acl" : [{"kind":"relation","object_name":"sasms.ai_recommendations","grantee":"sasms_app","privilege_type":"SELECT","is_grantable":false},
